{
  "name": "puter-account-pool-manager",
  "version": "1.0.0",
  "description": "Production-ready account pool manager for Puter.js AI accounts",
  "main": "dist/index.js",
  "bin": {
    "puter-pool": "./bin/puter-pool.js",
    "puter": "./bin/puter-pool.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "lsof -ti:3000 2>/dev/null | xargs kill -9 2>/dev/null || true; node dist/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "lsof -ti:3000 2>/dev/null | xargs kill -9 2>/dev/null || true; tsx watch src/index.ts",
    "dev:client": "lsof -ti:5173 2>/dev/null | xargs kill -9 2>/dev/null || true; lsof -ti:5174 2>/dev/null | xargs kill -9 2>/dev/null || true; vite --config dashboard/vite.config.ts --strictPort --port 5173 --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "node-fetch": "^2.7.0",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.4",
    "@types/node-fetch": "^2.6.13",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0"
}
